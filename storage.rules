rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {

    // Regras para imagens de eventos
    match /events/{imageId} {
      // Permitir leitura pública (qualquer pessoa pode ver as imagens)
      allow read: if true;

      // Permitir upload apenas para usuários autenticados
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // Máximo 5MB
                   && request.resource.contentType.matches('image/.*');  // Apenas imagens
    }

    // Regras para imagens de perfil de usuários
    match /profiles/{userId}/{imageId} {
      // Permitir leitura pública
      allow read: if true;

      // Permitir upload apenas para o próprio usuário
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // Máximo 5MB
                   && request.resource.contentType.matches('image/.*');  // Apenas imagens
    }

    // Bloquear tudo que não se encaixa nas regras acima
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
